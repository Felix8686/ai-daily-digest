# Gemini API Key (可前往 https://aistudio.google.com 免费获取)
GEMINI_API_KEY="AIzaSy..."

# SMTP 邮件发信配置
# 常用配置示例：
# QQ 邮箱: smtp.qq.com, 端口 465 (SSL), 密码是 QQ 邮箱设置里生成的「授权码」
# 163 邮箱: smtp.163.com, 端口 465 (SSL), 密码是「授权密码」
# Gmail: smtp.gmail.com, 端口 465 或 587, 密码是 Google 账号生成的「应用专用密码」
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER="your-email@qq.com"
SMTP_PASS="your-smtp-auth-token"

# 接收日报的邮箱地址（可以与 SMTP_USER 相同）
RECEIVER_EMAIL="your-email@qq.com"
